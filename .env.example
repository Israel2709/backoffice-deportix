# Public Deportix API base URL (no trailing slash).
# Portal uses NEXT_PUBLIC_API_BASE_URL; backoffice uses this server-only name via BFF.
DEPORTIX_API_BASE_URL=https://deportix-api.vercel.app

# Server-only admin key for write routes (/admin/*). Never expose as NEXT_PUBLIC_*.
# Firebase service-account / private keys belong on the API (Vercel), not in this app.
ADMIN_API_KEY=dev-local-key
