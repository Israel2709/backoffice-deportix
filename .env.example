# Public Deportix MVP API base URL (no trailing slash).
# Backoffice proxies browser calls through /api/proxy to this host.
#
# Defaults (when unset): https://deportix-api.vercel.app
# Local override in .env.local: http://localhost:3001
# On Vercel, localhost values are ignored and the production API is used.
#
# Soccer (fútbol) uses BFF paths: /countries, /leagues, /teams, /fixtures, /standings
# plus /v1/health, /v1/data-status, /v1/uploads (not legacy /admin/soccer/*).
DEPORTIX_API_BASE_URL=https://deportix-api.vercel.app

# Optional — only used when forwarding legacy Express /admin/* routes.
# Firebase service-account / private keys belong on the API (Vercel), not in this app.
ADMIN_API_KEY=dev-local-key
